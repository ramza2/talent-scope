# TalentScope server environment template.
#
# Usage:
#   cp .env.server.example .env.server
#   chmod 600 .env.server
#   edit secrets before deployment
#
# Never commit .env.server.

# -----------------------------------------------------------------------------
# Traefik / public host
# Existing shared Traefik on the target server:
#   network      = traefik_proxy
#   entrypoint   = websecure
#   certresolver = letsencrypt
# -----------------------------------------------------------------------------
TALENTSCOPE_HOST=talentscope.openlink.kr
TRAEFIK_NETWORK=traefik_proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# -----------------------------------------------------------------------------
# Application
# Generate a long random value, for example:
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
APP_ENV=production
APP_SECRET_KEY=change-me-use-openssl-rand-hex-32

# Browser server-session auth
SESSION_COOKIE_NAME=ts_session
SESSION_TTL_SECONDS=28800
CSRF_COOKIE_NAME=ts_csrf
REDIS_KEY_PREFIX=talentscope

# -----------------------------------------------------------------------------
# PostgreSQL
# *_test and *_perf names are intentionally separate from the product DB.
# The PERF benchmark refuses destructive writes unless the DB name contains
# _perf or _test and PERF_DATABASE_URL differs from DATABASE_URL.
# -----------------------------------------------------------------------------
POSTGRES_DB=talentscope
POSTGRES_USER=talentscope
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_TEST_DB=talentscope_test
POSTGRES_PERF_DB=talentscope_perf

# -----------------------------------------------------------------------------
# MinIO / S3-compatible object storage
# Internal containers use http://minio:9000 through docker-compose.server.yml.
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=talentscope
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_ACCESS_KEY=talentscope
S3_SECRET_KEY=change-me-minio-password
S3_BUCKET=talent-scope

# Upload limits
UPLOAD_MAX_FILE_SIZE_MB=50
UPLOAD_MAX_FILES_PER_SESSION=20
UPLOAD_SESSION_TTL_HOURS=24

# Document processing
LIBREOFFICE_BIN=soffice
LIBREOFFICE_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# ALZI OpenAI-compatible AI runtimes
# Replace API keys with server-side secrets. Do not expose them to the browser.
# -----------------------------------------------------------------------------
LLM_BASE_URL=https://alzi-llm.openlink.kr
LLM_API_KEY=change-me
LLM_MODEL=Qwen3-14B

VLM_BASE_URL=https://alzi-vlm.openlink.kr
VLM_API_KEY=change-me
VLM_MODEL=Qwen2.5-VL-7B-Instruct

AI_REQUEST_TIMEOUT_SECONDS=60
IDENTIFY_MAX_PAGES=5
IDENTIFY_MAX_VLM_PAGES=3
IDENTIFY_MAX_TEXT_CHARS=20000
IDENTIFY_PDF_RENDER_DPI=120

ANALYSIS_MAX_PAGES_PER_DOCUMENT=10
ANALYSIS_MAX_VLM_PAGES=5
ANALYSIS_MAX_TOTAL_TEXT_CHARS=40000
ANALYSIS_PDF_RENDER_DPI=120
ANALYSIS_CODE_CONTEXT_MAX_CHARS=12000
ANALYSIS_MAX_QUOTE_CHARS=400
ANALYSIS_MAX_SOURCE_REFS=5

# -----------------------------------------------------------------------------
# Embedding runtime
# Fill in the OpenAI-compatible BGE-M3 endpoint used by this server.
# Set EMBEDDING_ENABLED=true only after the endpoint/key are valid.
# -----------------------------------------------------------------------------
EMBEDDING_BASE_URL=change-me
EMBEDDING_API_KEY=change-me
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ENABLED=false
EMBEDDING_REQUEST_TIMEOUT_SECONDS=60
EMBEDDING_MAX_INPUT_CHARS=8000
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF_SECONDS=60
