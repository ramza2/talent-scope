# TalentScope environment configuration example.
# Copy to `.env` and adjust. Do NOT commit real secrets.
# See docs/13_application_architecture.md section 17 for the full list.

APP_ENV=development
APP_SECRET_KEY=change-me

# PostgreSQL + pgvector (provisioned by scripts/cloud-install.sh)
DATABASE_URL=postgresql+psycopg://talentscope:talentscope@127.0.0.1:5432/talentscope

# Redis (Celery broker / short-lived cache) - not provisioned by the dev env yet
REDIS_URL=redis://127.0.0.1:6379/0

# MinIO / S3-compatible object storage - not provisioned by the dev env yet
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=talent-scope

# ALZI OpenAI-compatible AI runtime (external)
LLM_BASE_URL=https://alzi-llm.openlink.kr
LLM_API_KEY=change-me
LLM_MODEL=Qwen3-14B

VLM_BASE_URL=https://alzi-vlm.openlink.kr
VLM_API_KEY=change-me
VLM_MODEL=Qwen2.5-VL-7B-Instruct

EMBEDDING_BASE_URL=change-me
EMBEDDING_API_KEY=change-me
EMBEDDING_MODEL=bge-m3

TALENTSCOPE_HOST=localhost
