# TalentScope environment configuration example.
# Copy to `.env` before running docker compose:
#   cp .env.example .env
# Compose injects `.env` into api/worker containers (not this template file).
# Do NOT commit real secrets.
# See docs/13_application_architecture.md section 17 for the full list.

APP_ENV=development
APP_SECRET_KEY=change-me

# PostgreSQL + pgvector (provisioned by scripts/cloud-install.sh)
DATABASE_URL=postgresql+psycopg://talentscope:talentscope@127.0.0.1:5432/talentscope

# Redis (Celery broker / short-lived cache)
# Cloud Agent: provisioned by scripts/cloud-install.sh + cloud-start.sh
# Local Docker: docker-compose.dev.yml service `redis`
REDIS_URL=redis://127.0.0.1:6379/0

# MinIO / S3-compatible object storage
# Local Docker: docker-compose.dev.yml service `minio` (defaults below)
# Cloud Agent: optional — use compose or external MinIO; not required for skeleton
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=talent-scope

# Upload limits (docs/15 — 413 on exceed)
UPLOAD_MAX_FILE_SIZE_MB=50
UPLOAD_MAX_FILES_PER_SESSION=20
UPLOAD_SESSION_TTL_HOURS=24

# Document processing (LibreOffice headless convert)
LIBREOFFICE_BIN=soffice
LIBREOFFICE_TIMEOUT_SECONDS=120

# ALZI OpenAI-compatible AI runtime (external)
LLM_BASE_URL=https://alzi-llm.openlink.kr
LLM_API_KEY=change-me
LLM_MODEL=Qwen3-14B

VLM_BASE_URL=https://alzi-vlm.openlink.kr
VLM_API_KEY=change-me
VLM_MODEL=Qwen2.5-VL-7B-Instruct

# Upload identify / AI request limits
AI_REQUEST_TIMEOUT_SECONDS=60
IDENTIFY_MAX_PAGES=5
IDENTIFY_MAX_VLM_PAGES=3
IDENTIFY_MAX_TEXT_CHARS=20000
IDENTIFY_PDF_RENDER_DPI=120

# Detailed profile analysis limits
ANALYSIS_MAX_PAGES_PER_DOCUMENT=10
ANALYSIS_MAX_VLM_PAGES=5
ANALYSIS_MAX_TOTAL_TEXT_CHARS=40000
ANALYSIS_PDF_RENDER_DPI=120
ANALYSIS_CODE_CONTEXT_MAX_CHARS=12000
ANALYSIS_MAX_QUOTE_CHARS=400
ANALYSIS_MAX_SOURCE_REFS=5

EMBEDDING_BASE_URL=change-me
EMBEDDING_API_KEY=change-me
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ENABLED=false
EMBEDDING_REQUEST_TIMEOUT_SECONDS=60
EMBEDDING_MAX_INPUT_CHARS=8000
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF_SECONDS=60

TALENTSCOPE_HOST=localhost

# Browser server-session auth (docs/15)
SESSION_COOKIE_NAME=ts_session
SESSION_TTL_SECONDS=28800
CSRF_COOKIE_NAME=ts_csrf
# REDIS_KEY_PREFIX=talentscope
